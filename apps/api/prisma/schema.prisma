generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  STRIPE
  OTHER
}

enum AppointmentSource {
  ONLINE
  WALK_IN
  PHONE
  MANUAL
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum PaymentItemType {
  SERVICE
  PRODUCT
  OTHER
}

enum NotificationStatus {
  SENT
  FAILED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SubscriptionPlan {
  BASICO
  PLUS
  PRO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

enum BusinessType {
  SALON
  BARBERIA
  SPA
  CLINICA
  TATUAJES
}

enum FulfillmentType {
  PICKUP
  SHIPPING
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  READY
  DELIVERED
  CANCELLED
}

enum ShopPaymentMethod {
  CASH
  SPEI
  CARD
}

// ─── PLATFORM USERS (Super Admin) ──────────────────

model PlatformUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens PlatformRefreshToken[]

  @@map("platform_users")
}

model PlatformRefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  tokenHint String    @default("") @map("token_hint")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHint])
  @@index([userId])
  @@map("platform_refresh_tokens")
}

// ─── MARKETPLACE USERS (Global Client Identity) ────

model MarketplaceUser {
  id           String    @id @default(uuid())
  email          String    @unique
  phone          String?   @unique
  passwordHash   String?   @map("password_hash")
  socialProvider String?   @map("social_provider") @db.VarChar(20) // google, facebook
  socialId       String?   @map("social_id") @db.VarChar(255)
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  avatarUrl      String?   @map("avatar_url")
  birthDate    DateTime? @map("birth_date") @db.Date
  gender       String?   @db.VarChar(20) // MALE, FEMALE, NON_BINARY, PREFER_NOT_SAY
  allergies    String?   @db.Text // Free-text medical notes / allergies
  address      String?   @db.Text
  country      String?   @db.VarChar(2) // ISO 3166-1 alpha-2 (MX, US, CO, etc.)
  language     String    @default("es") @db.VarChar(5) // es, en, pt
  currency     String    @default("LOCAL") @db.VarChar(10) // LOCAL or USD
  searchRadius Int       @default(25) @map("search_radius") // Default km for discover
  notifAppointments Boolean @default(true) @map("notif_appointments")
  notifPromotions   Boolean @default(true) @map("notif_promotions")
  notifRewards      Boolean @default(true) @map("notif_rewards")
  notifMessages     Boolean @default(true) @map("notif_messages")
  isActive       Boolean   @default(true) @map("is_active")
  suspendedAt    DateTime? @map("suspended_at")
  suspendedUntil DateTime? @map("suspended_until")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens MarketplaceRefreshToken[]
  clients       Client[]
  favorites              MarketplaceFavorite[]
  professionalFavorites  MarketplaceProfessionalFavorite[]

  @@map("marketplace_users")
}

model MarketplaceRefreshToken {
  id                String    @id @default(uuid())
  marketplaceUserId String    @map("marketplace_user_id")
  tokenHash         String    @map("token_hash")
  tokenHint         String    @default("") @map("token_hint") @db.VarChar(8)
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user MarketplaceUser @relation(fields: [marketplaceUserId], references: [id], onDelete: Cascade)

  @@index([marketplaceUserId])
  @@map("marketplace_refresh_tokens")
}

// ─── TENANTS ────────────────────────────────────────

model Tenant {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  email                String
  phone                String?
  logoUrl              String?   @map("logo_url")
  timezone             String    @default("UTC")
  currency             String    @default("USD")
  settings             Json?
  businessType         String?   @map("business_type")
  address              String?
  businessPhone        String?   @map("business_phone")
  description          String?   @db.Text
  coverImageUrl        String?   @map("cover_image_url")
  cardColor            String?   @map("card_color")
  isMarketplaceListed      Boolean   @default(false) @map("is_marketplace_listed")
  contractAcceptedAt       DateTime? @map("contract_accepted_at")
  stripeAccountId          String?   @map("stripe_account_id")
  stripeOnboardingComplete Boolean   @default(false) @map("stripe_onboarding_complete")
  subscriptionPlan     String    @default("free") @map("subscription_plan")
  subscriptionStatus   String    @default("active") @map("subscription_status")
  shopEnabled          Boolean   @default(false) @map("shop_enabled")
  shopPickupEnabled    Boolean   @default(true) @map("shop_pickup_enabled")
  shopShippingEnabled  Boolean   @default(false) @map("shop_shipping_enabled")
  shopPaymentCash      Boolean   @default(true) @map("shop_payment_cash")
  shopPaymentSpei      Boolean   @default(false) @map("shop_payment_spei")
  shopPaymentCard      Boolean   @default(false) @map("shop_payment_card")
  shopSpeiBankName     String?   @map("shop_spei_bank_name")
  shopSpeiHolderName   String?   @map("shop_spei_holder_name")
  shopSpeiClabe        String?   @map("shop_spei_clabe") @db.VarChar(18)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  locations             Location[]
  users                 User[]
  clients               Client[]
  services              Service[]
  employees             Employee[]
  resources             Resource[]
  appointments          Appointment[]
  payments              Payment[]
  roles                 Role[]
  auditLogs             AuditLog[]
  domainEvents          DomainEvent[]
  userRoles             UserRole[]
  automationRules       AutomationRule[]
  notificationTemplates NotificationTemplate[]
  notificationLogs      NotificationLog[]
  clientTags            ClientTag[]
  businessHours         BusinessHours[]
  businessClosures      BusinessClosure[]
  employeeReviews       EmployeeReview[]
  inviteCodes           TenantInviteCode[]
  subscription          Subscription?
  invoices              Invoice[]
  appointmentPhotos     AppointmentPhoto[]
  galleryImages         TenantGalleryImage[]
  rewards               Reward[]
  rewardRedemptions     RewardRedemption[]
  marketplaceFavorites  MarketplaceFavorite[]
  products              Product[]
  suppliers             Supplier[]
  promotions            Promotion[]
  serviceBundles        ServiceBundle[]
  productReservations   ProductReservation[]

  @@map("tenants")
}

// ─── SUBSCRIPTIONS ─────────────────────────────────

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique @map("tenant_id")
  plan                 SubscriptionPlan   @default(BASICO)
  status               SubscriptionStatus @default(ACTIVE)
  monthlyAmountUsd     Decimal            @map("monthly_amount_usd") @db.Decimal(10, 2)
  baseMonthlyUsd       Decimal            @default(10) @map("base_monthly_usd") @db.Decimal(10, 2)
  perEmployeeUsd       Decimal            @default(10) @map("per_employee_usd") @db.Decimal(10, 2)
  billedEmployeeCount  Int                @default(0) @map("billed_employee_count")
  availableLicenses    Int                @default(0) @map("available_licenses")
  planInterval         String             @default("MONTHLY") @map("plan_interval")
  annualAmountUsd      Decimal?           @map("annual_amount_usd") @db.Decimal(10, 2)
  annualPeriodEnd      DateTime?          @map("annual_period_end")
  advancePaid          Boolean            @default(false) @map("advance_paid")
  contractStartDate    DateTime           @map("contract_start_date")
  contractEndDate      DateTime           @map("contract_end_date")
  nextBillingDate      DateTime           @map("next_billing_date")
  lastPaymentDate      DateTime?          @map("last_payment_date")
  gracePeriodEndsAt    DateTime?          @map("grace_period_ends_at")
  cancelledAt          DateTime?          @map("cancelled_at")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  stripeCustomerId     String?            @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?            @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId        String?            @map("stripe_price_id") @db.VarChar(255)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(uuid())
  subscriptionId  String        @map("subscription_id")
  tenantId        String        @map("tenant_id")
  invoiceNumber   String        @unique @map("invoice_number")
  amountUsd       Decimal       @map("amount_usd") @db.Decimal(10, 2)
  baseAmount      Decimal?      @map("base_amount") @db.Decimal(10, 2)
  employeeAmount  Decimal?      @map("employee_amount") @db.Decimal(10, 2)
  employeeCount   Int?          @map("employee_count")
  status          InvoiceStatus @default(PENDING)
  periodStart     DateTime      @map("period_start")
  periodEnd       DateTime      @map("period_end")
  dueDate         DateTime      @map("due_date")
  paidAt          DateTime?     @map("paid_at")
  notes           String?       @db.Text
  stripeInvoiceId String?       @map("stripe_invoice_id") @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

// ─── LOCATIONS ──────────────────────────────────────

model Location {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  address   String?
  phone     String?
  email     String?
  timezone  String?
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true) @map("is_active")
  settings  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees    Employee[]
  resources    Resource[]
  appointments Appointment[]
  userRoles    UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("locations")
}

// ─── USERS ──────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  email           String
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee?
  refreshTokens  RefreshToken[]
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  uploadedPhotos AppointmentPhoto[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  tokenHint String    @default("") @map("token_hint")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHint])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─── RBAC ───────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  slug        String
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  tenantId   String   @map("tenant_id")
  locationId String?  @map("location_id")
  assignedBy String?  @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([userId, tenantId])
  @@index([tenantId])
  @@map("user_roles")
}

// ─── CLIENTS ────────────────────────────────────────

model Client {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String?
  phone              String?
  gender             String?
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  notes              String?   @db.Text
  avatarUrl          String?   @map("avatar_url")
  isActive           Boolean   @default(true) @map("is_active")
  source             String?
  passwordHash       String?   @map("password_hash")
  portalRegisteredAt DateTime? @map("portal_registered_at")
  lastLoginAt        DateTime? @map("last_login_at")
  marketplaceUserId  String?   @map("marketplace_user_id")
  loyaltyPoints      Int       @default(0) @map("loyalty_points")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  marketplaceUser MarketplaceUser?    @relation(fields: [marketplaceUserId], references: [id], onDelete: SetNull)
  appointments    Appointment[]
  payments        Payment[]
  tags            ClientTagMap[]
  reviews            EmployeeReview[]
  refreshTokens      ClientRefreshToken[]
  rewardRedemptions  RewardRedemption[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([marketplaceUserId])
  @@map("clients")
}

model ClientTag {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clients ClientTagMap[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("client_tags")
}

model ClientTagMap {
  clientId  String   @map("client_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  client Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    ClientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@map("client_tag_map")
}

// ─── CLIENT REFRESH TOKENS ─────────────────────────

model ClientRefreshToken {
  id        String    @id @default(uuid())
  clientId  String    @map("client_id")
  tokenHash String    @map("token_hash")
  tokenHint String    @default("") @map("token_hint")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tokenHint])
  @@index([clientId])
  @@map("client_refresh_tokens")
}

// ─── SERVICES ───────────────────────────────────────

model Service {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  name                String
  description         String?  @db.Text
  durationMinutes     Int      @map("duration_minutes")
  bufferBeforeMinutes Int      @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int      @default(0) @map("buffer_after_minutes")
  price               Decimal  @db.Decimal(10, 2)
  currency            String   @default("USD")
  color               String   @default("#6366f1")
  category            String?
  subcategory         String?
  pointsReward        Int?     @map("points_reward")
  redeemableWithPoints Boolean @default(false) @map("redeemable_with_points")
  pointsRequired      Int?     @map("points_required")
  depositRequired     Boolean  @default(false) @map("deposit_required")
  depositPercent      Int?     @map("deposit_percent")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeServices EmployeeService[]
  addons           ServiceAddon[]
  appointmentItems AppointmentItem[]
  serviceResources ServiceResource[]
  rewards          Reward[]
  inviteCodes      TenantInviteCodeService[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("services")
}

model ServiceAddon {
  id              String   @id @default(uuid())
  serviceId       String   @map("service_id")
  name            String
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_addons")
}

// ─── EMPLOYEES ──────────────────────────────────────

model Employee {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  userId              String?  @unique @map("user_id")
  locationId          String   @map("location_id")
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  email               String?
  phone               String?
  avatarUrl           String?  @map("avatar_url")
  coverImageUrl       String?  @map("cover_image_url")
  color               String   @default("#008080")
  bio                 String?  @db.Text
  bloodType                String?  @map("blood_type") @db.VarChar(5)
  emergencyContactName     String?  @map("emergency_contact_name")
  emergencyContactLastName String?  @map("emergency_contact_last_name")
  emergencyContactPhone    String?  @map("emergency_contact_phone")
  emergencyContactRelation String?  @map("emergency_contact_relation") @db.VarChar(50)
  allergies                String?  @db.Text
  jobTitle            String?  @map("job_title")
  isActive            Boolean  @default(true) @map("is_active")
  bufferBeforeMinutes Int      @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int      @default(0) @map("buffer_after_minutes")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  location         Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employeeServices EmployeeService[]
  schedules        EmployeeSchedule[]
  timeOffs         EmployeeTimeOff[]
  appointments     Appointment[]
  appointmentItems AppointmentItem[]
  portfolioImages  EmployeePortfolioImage[]
  reviews          EmployeeReview[]
  documents        EmployeeDocument[]
  trainings              EmployeeTraining[]
  professionalFavorites  MarketplaceProfessionalFavorite[]

  @@index([tenantId])
  @@index([tenantId, locationId])
  @@map("employees")
}

model EmployeeService {
  employeeId     String   @map("employee_id")
  serviceId      String   @map("service_id")
  customPrice    Decimal? @map("custom_price") @db.Decimal(10, 2)
  customDuration Int?     @map("custom_duration")
  commission     Decimal? @map("commission") @db.Decimal(10, 2)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
  @@map("employee_services")
}

model EmployeeSchedule {
  id             String    @id @default(uuid())
  employeeId     String    @map("employee_id")
  dayOfWeek      DayOfWeek @map("day_of_week")
  startTime      String    @map("start_time")  // "HH:mm" format
  endTime        String    @map("end_time")    // "HH:mm" format
  isWorking      Boolean   @default(true) @map("is_working")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, dayOfWeek])
  @@index([employeeId, effectiveFrom])
  @@map("employee_schedules")
}

model EmployeeTimeOff {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  startDatetime DateTime @map("start_datetime")
  endDatetime   DateTime @map("end_datetime")
  reason          String?
  isAllDay        Boolean   @default(false) @map("is_all_day")
  status          String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, startDatetime, endDatetime])
  @@map("employee_time_off")
}

// ─── RESOURCES ──────────────────────────────────────

model Resource {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  locationId  String   @map("location_id")
  name        String
  type        String?
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location         Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  serviceResources ServiceResource[]
  appointmentItems AppointmentItem[]

  @@index([tenantId, locationId])
  @@map("resources")
}

model ServiceResource {
  serviceId  String @map("service_id")
  resourceId String @map("resource_id")
  quantity   Int    @default(1)

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@map("service_resources")
}

// ─── APPOINTMENTS ───────────────────────────────────

model Appointment {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  locationId         String            @map("location_id")
  clientId           String            @map("client_id")
  employeeId         String            @map("employee_id")
  status             AppointmentStatus @default(PENDING)
  startTime          DateTime          @map("start_time")
  endTime            DateTime          @map("end_time")
  notes              String?           @db.Text
  internalNotes      String?           @map("internal_notes") @db.Text
  cancellationReason String?           @map("cancellation_reason") @db.Text
  cancelledBy        String?           @map("cancelled_by")
  source             AppointmentSource @default(MANUAL)
  createdBy          String?           @map("created_by")
  photoConsent       Boolean?          @map("photo_consent")
  photoConsentAt     DateTime?         @map("photo_consent_at")
  redemptionId       String?           @unique @map("redemption_id")
  discountAmount     Decimal?          @map("discount_amount") @db.Decimal(10, 2)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      Location                   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  client        Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee      Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  redemption    RewardRedemption?          @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  items         AppointmentItem[]
  statusHistory AppointmentStatusHistory[]
  payments      Payment[]
  review        EmployeeReview?
  photos        AppointmentPhoto[]

  @@index([tenantId, locationId, startTime])
  @@index([employeeId, startTime, endTime])
  @@index([clientId])
  @@index([status])
  @@map("appointments")
}

model AppointmentItem {
  id                  String   @id @default(uuid())
  appointmentId       String   @map("appointment_id")
  serviceId           String   @map("service_id")
  employeeId          String   @map("employee_id")
  resourceId          String?  @map("resource_id")
  startTime           DateTime @map("start_time")
  endTime             DateTime @map("end_time")
  priceSnapshot       Decimal  @map("price_snapshot") @db.Decimal(10, 2)
  commissionSnapshot  Decimal? @map("commission_snapshot") @db.Decimal(10, 2)
  durationSnapshot    Int      @map("duration_snapshot")
  serviceNameSnapshot String   @map("service_name_snapshot")
  notes               String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resource    Resource?   @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([employeeId, startTime, endTime])
  @@map("appointment_items")
}

model AppointmentStatusHistory {
  id            String             @id @default(uuid())
  appointmentId String             @map("appointment_id")
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  changedBy     String?            @map("changed_by")
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_status_history")
}

// ─── APPOINTMENT PHOTOS ────────────────────────────

model AppointmentPhoto {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  appointmentId String   @map("appointment_id")
  imageUrl      String   @map("image_url")
  caption       String?  @db.VarChar(255)
  uploadedById  String?  @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  uploadedBy  User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId, appointmentId])
  @@map("appointment_photos")
}

// ─── PAYMENTS ───────────────────────────────────────

model Payment {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  appointmentId  String?       @map("appointment_id")
  clientId       String        @map("client_id")
  locationId     String        @map("location_id")
  amount         Decimal       @db.Decimal(10, 2)
  tipAmount      Decimal       @default(0) @map("tip_amount") @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency       String        @default("USD")
  paymentMethod  PaymentMethod @map("payment_method")
  status         PaymentStatus @default(PENDING)
  reference             String?
  stripeSessionId       String?  @map("stripe_session_id")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  notes                 String?
  createdBy      String?       @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items       PaymentItem[]

  @@index([tenantId])
  @@index([appointmentId])
  @@index([clientId])
  @@index([tenantId, createdAt])
  @@map("payments")
}

model PaymentItem {
  id            String          @id @default(uuid())
  paymentId     String          @map("payment_id")
  description   String
  quantity      Int             @default(1)
  unitPrice     Decimal         @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal         @map("total_price") @db.Decimal(10, 2)
  itemType      PaymentItemType @map("item_type")
  referenceId   String?         @map("reference_id")
  referenceType String?         @map("reference_type")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_items")
}

// ─── AUDIT ──────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_log")
}

// ─── DOMAIN EVENTS ──────────────────────────────────

model DomainEvent {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  eventName     String    @map("event_name")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([eventName])
  @@index([processedAt])
  @@map("domain_events")
}

// ─── AUTOMATIONS ────────────────────────────────────

model AutomationRule {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  name                 String
  description          String?
  triggerType          String    @map("trigger_type")
  triggerConfig        Json      @map("trigger_config")
  conditionConfig      Json?     @map("condition_config")
  actionType           String    @map("action_type")
  actionConfig         Json      @map("action_config")
  isActive             Boolean   @default(false) @map("is_active")
  quietHoursStart      String?   @map("quiet_hours_start")
  quietHoursEnd        String?   @map("quiet_hours_end")
  rateLimitPerClient   Int?      @map("rate_limit_per_client")
  rateLimitWindowHours Int?      @map("rate_limit_window_hours")
  lastTriggeredAt      DateTime? @map("last_triggered_at")
  executionCount       Int       @default(0) @map("execution_count")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("automation_rules")
}

// ─── BUSINESS HOURS ────────────────────────────────

model BusinessHours {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  dayOfWeek DayOfWeek @map("day_of_week")
  openTime  String    @map("open_time")
  closeTime String    @map("close_time")
  isOpen    Boolean   @default(true) @map("is_open")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@map("business_hours")
}

// ─── BUSINESS CLOSURES ─────────────────────────────

model BusinessClosure {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startDate, endDate])
  @@map("business_closures")
}

// ─── NOTIFICATIONS ──────────────────────────────────

model NotificationTemplate {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  type         NotificationType
  eventTrigger String           @map("event_trigger")
  subject      String?
  bodyTemplate String           @map("body_template") @db.Text
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   NotificationLog[]

  @@index([tenantId, eventTrigger])
  @@map("notification_templates")
}

model NotificationLog {
  id             String             @id @default(uuid())
  tenantId       String             @map("tenant_id")
  templateId     String?            @map("template_id")
  channel        NotificationType
  eventName      String             @map("event_name")
  recipientEmail String?            @map("recipient_email")
  recipientPhone String?            @map("recipient_phone")
  subject        String?
  body           String             @db.Text
  status         NotificationStatus
  error          String?            @db.Text
  metadata       Json?
  sentAt         DateTime?          @map("sent_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, eventName])
  @@index([status])
  @@map("notification_logs")
}

// ─── TENANT INVITE CODES ──────────────────────────

model TenantInviteCode {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  code      String    @unique
  jobTitle  String?   @map("job_title")
  maxUses   Int       @default(0) @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services TenantInviteCodeService[]

  @@index([tenantId])
  @@map("tenant_invite_codes")
}

model TenantInviteCodeService {
  id           String @id @default(uuid())
  inviteCodeId String @map("invite_code_id")
  serviceId    String @map("service_id")

  inviteCode TenantInviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  service    Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([inviteCodeId, serviceId])
  @@map("tenant_invite_code_services")
}

// ─── EMPLOYEE PORTFOLIO ────────────────────────────

model EmployeePortfolioImage {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  imageUrl   String   @map("image_url")
  caption    String?  @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_portfolio_images")
}

// ─── EMPLOYEE REVIEWS ──────────────────────────────

model EmployeeReview {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  employeeId      String    @map("employee_id")
  clientId        String    @map("client_id")
  appointmentId   String    @unique @map("appointment_id")
  rating          Int
  comment         String?   @db.Text
  businessRating  Int?      @map("business_rating")
  businessComment String?   @db.Text @map("business_comment")
  isVisible       Boolean   @default(true) @map("is_visible")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tenantId])
  @@map("employee_reviews")
}

// ─── EMPLOYEE DOCUMENTS ───────────────────────────

model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  documentType String   @map("document_type") @db.VarChar(50)
  fileUrl      String   @map("file_url")
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, documentType])
  @@index([employeeId])
  @@map("employee_documents")
}

// ─── EMPLOYEE TRAININGS ───────────────────────────

model EmployeeTraining {
  id            String    @id @default(uuid())
  employeeId    String    @map("employee_id")
  title         String    @db.VarChar(200)
  institution   String?   @db.VarChar(200)
  dateCompleted DateTime? @map("date_completed") @db.Date
  fileUrl       String?   @map("file_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_trainings")
}

// ─── TENANT GALLERY ──────────────────────────────

model TenantGalleryImage {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  imageUrl  String   @map("image_url")
  caption   String?  @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_gallery_images")
}

// ─── REWARDS ──────────────────────────────────────

model Reward {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  name           String    @db.VarChar(200)
  description    String?   @db.Text
  type           String    // SERVICIO | DESCUENTO
  pointsRequired Int       @map("points_required")
  serviceId      String?   @map("service_id")
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(10, 2)
  discountMode   String?   @map("discount_mode") // FLAT | PERCENTAGE
  isActive       Boolean   @default(true) @map("is_active")
  maxRedemptions Int?      @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  validUntil     DateTime? @map("valid_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service     Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  redemptions RewardRedemption[]

  @@index([tenantId, isActive])
  @@map("rewards")
}

model RewardRedemption {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  rewardId    String    @map("reward_id")
  clientId    String    @map("client_id")
  pointsSpent Int       @map("points_spent")
  status      String    @default("ACTIVE") // ACTIVE | USED | EXPIRED
  code        String    @unique @db.VarChar(12)
  expiresAt   DateTime? @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward      Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@index([tenantId])
  @@index([clientId])
  @@index([code])
  @@map("reward_redemptions")
}

// ─── MARKETPLACE FAVORITES ────────────────────────

model MarketplaceFavorite {
  id                String   @id @default(cuid())
  marketplaceUserId String   @map("marketplace_user_id")
  tenantId          String   @map("tenant_id")
  createdAt         DateTime @default(now()) @map("created_at")

  marketplaceUser MarketplaceUser @relation(fields: [marketplaceUserId], references: [id], onDelete: Cascade)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([marketplaceUserId, tenantId])
  @@index([marketplaceUserId])
  @@map("marketplace_favorites")
}

model MarketplaceProfessionalFavorite {
  id                String   @id @default(cuid())
  marketplaceUserId String   @map("marketplace_user_id")
  employeeId        String   @map("employee_id")
  createdAt         DateTime @default(now()) @map("created_at")

  marketplaceUser MarketplaceUser @relation(fields: [marketplaceUserId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([marketplaceUserId, employeeId])
  @@index([marketplaceUserId])
  @@map("marketplace_professional_favorites")
}

// ─── BUSINESS TYPE CATALOG ─────────────────────────

model BusinessTypeCatalog {
  id        String   @id @default(uuid())
  value     String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("business_type_catalog")
}

// ─── PROFESSION CATALOG ────────────────────────────

model Profession {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("professions")
}

model ServiceCatalog {
  id        String   @id @default(uuid())
  name      String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([name, category])
  @@map("service_catalog")
}

// ─── SUPPLIERS ──────────────────────────────────────

model Supplier {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  contactName String?  @map("contact_name")
  email       String?
  phone       String?
  address     String?  @db.Text
  notes       String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("suppliers")
}

// ─── PRODUCTS (INVENTORY) ──────────────────────────

model Product {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  sku          String?  @db.VarChar(100)
  description  String?  @db.Text
  category     String?
  price        Decimal  @db.Decimal(10, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(10, 2)
  stock        Int      @default(0)
  minStock     Int      @default(0) @map("min_stock")
  unit         String   @default("unidad") @db.VarChar(50)
  supplierId   String?  @map("supplier_id")
  currency     String   @default("MXN") @db.VarChar(3)
  imageUrl     String?  @map("image_url")
  supplierUrl  String?  @map("supplier_url")
  notes        String?  @db.Text
  shippingEnabled Boolean  @default(false) @map("shipping_enabled")
  shippingCost    Decimal? @map("shipping_cost") @db.Decimal(10, 2)
  isShopListed    Boolean  @default(false) @map("is_shop_listed")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  reservations ProductReservation[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, isShopListed, isActive])
  @@index([supplierId])
  @@map("products")
}

// ─── PRODUCT IMAGES ───────────────────────────────

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─── PRODUCT RESERVATIONS ─────────────────────────

model ProductReservation {
  id                     String            @id @default(uuid())
  tenantId               String            @map("tenant_id")
  productId              String            @map("product_id")
  quantity               Int               @default(1)
  unitPrice              Decimal           @map("unit_price") @db.Decimal(10, 2)
  shippingCost           Decimal           @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  customerName           String            @map("customer_name")
  customerEmail          String?           @map("customer_email")
  customerPhone          String            @map("customer_phone")
  fulfillmentType        FulfillmentType   @map("fulfillment_type")
  preferredPaymentMethod ShopPaymentMethod @map("preferred_payment_method")
  status                 ReservationStatus @default(PENDING)
  shippingAddress        String?           @map("shipping_address") @db.Text
  notes                  String?           @db.Text
  marketplaceUserId      String?           @map("marketplace_user_id")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([productId])
  @@map("product_reservations")
}

// ─── PROMOTIONS ─────────────────────────────────────

model Promotion {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  description String? @db.Text
  type       String   // PERCENTAGE, FIXED_AMOUNT, TWO_FOR_ONE
  value      Decimal  @db.Decimal(10, 2)
  code       String?  @db.VarChar(50)
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  maxUses    Int?     @map("max_uses")
  usedCount  Int      @default(0) @map("used_count")
  serviceIds Json?    @map("service_ids") // array of service IDs this applies to
  minAmount  Decimal? @map("min_amount") @db.Decimal(10, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@index([code])
  @@map("promotions")
}

// ─── SERVICE BUNDLES ────────────────────────────────

model ServiceBundle {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  description    String?  @db.Text
  bundlePrice    Decimal  @map("bundle_price") @db.Decimal(10, 2)
  serviceIds     Json     @map("service_ids") // array of service IDs
  totalDuration  Int      @map("total_duration") // sum of durations
  savingsPercent Decimal? @map("savings_percent") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("service_bundles")
}

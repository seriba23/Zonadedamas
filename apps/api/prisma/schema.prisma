// ─── REWARDS ──────────────────────────────────────

model Reward {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  name           String    @db.VarChar(200)
  description    String?   @db.Text
  type           String    // SERVICIO | DESCUENTO | TWO_FOR_ONE
  pointsRequired Int?      @map("points_required")
  // Para SERVICIO: el servicio que se regala (1 solo).
  serviceId      String?   @map("service_id")
  // Para DESCUENTO/TWO_FOR_ONE: array de servicios donde aplica. Null = aplica a todos.
  serviceIds     Json?     @map("service_ids")
  discountAmount Decimal?  @map("discount_amount") @db.Decimal(10, 2)
  discountMode   String?   @map("discount_mode") // FLAT | PERCENTAGE
  // Migrado desde Promotion: rango de vigencia, codigo publico, monto minimo,
  // bloquear pago con puntos, contador de usos.
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  code           String?   @db.VarChar(50)
  minAmount      Decimal?  @map("min_amount") @db.Decimal(10, 2)
  allowPointPayment Boolean @default(true) @map("allow_point_payment")
  isActive       Boolean   @default(true) @map("is_active")
  maxRedemptions Int?      @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  validUntil     DateTime? @map("valid_until") // legacy — preferir endDate
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service     Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  redemptions RewardRedemption[]
  referrals   RewardReferral[]

  @@index([tenantId, isActive])
  @@index([code])
  @@map("rewards")
}

model RewardRedemption {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  rewardId    String    @map("reward_id")
  clientId    String    @map("client_id")
  pointsSpent Int       @map("points_spent")
  status      String    @default("ACTIVE") // ACTIVE | USED | EXPIRED
  code        String    @unique @db.VarChar(12)
  expiresAt   DateTime? @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward      Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@index([tenantId])
  @@index([clientId])
  @@index([code])
  @@map("reward_redemptions")
}

// ─── REWARD REFERRALS (2x1, sistema de referidos) ────
// Migrado desde PromotionReferral. Cuando un cliente reserva un Reward de
// tipo TWO_FOR_ONE, se genera un RewardReferral con un codigo unico que
// puede compartir con un amigo. Al amigo entrar con ?ref=CODE se valida y
// se aplica el descuento.
model RewardReferral {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  rewardId              String    @map("reward_id")
  appointmentId         String    @map("appointment_id")
  serviceIds            Json      @map("service_ids")
  code                  String    @unique @db.VarChar(12)
  generatedByClientId   String    @map("generated_by_client_id")
  redeemedByClientId    String?   @map("redeemed_by_client_id")
  redeemedAppointmentId String?   @map("redeemed_appointment_id")
  status                String    @default("ACTIVE") // ACTIVE | USED | EXPIRED
  expiresAt             DateTime? @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  usedAt                DateTime? @map("used_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([tenantId])
  @@index([code])
  @@map("reward_referrals")
}

// ─── MARKETPLACE FAVORITES ────────────────────────

model MarketplaceFavorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@map("marketplace_favorites")
}

model MarketplaceProfessionalFavorite {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  employeeId String   @map("employee_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([userId, employeeId])
  @@index([userId])
  @@map("marketplace_professional_favorites")
}

// ─── BUSINESS TYPE CATALOG ─────────────────────────

model BusinessTypeCatalog {
  id        String   @id @default(uuid())
  value     String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("business_type_catalog")
}

// ─── PROFESSION CATALOG ────────────────────────────

model Profession {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("professions")
}

model ServiceCatalog {
  id        String   @id @default(uuid())
  name      String
  category  String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([name, category])
  @@map("service_catalog")
}

// ─── SUPPLIERS ──────────────────────────────────────

model Supplier {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  contactName String?  @map("contact_name")
  email       String?
  phone       String?
  address     String?  @db.Text
  notes       String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("suppliers")
}

// ─── PRODUCTS (INVENTORY) ──────────────────────────

model Product {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  sku          String?  @db.VarChar(100)
  description  String?  @db.Text
  category     String?
  price        Decimal  @db.Decimal(10, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(10, 2)
  stock        Int      @default(0)
  minStock     Int      @default(0) @map("min_stock")
  unit         String   @default("unidad") @db.VarChar(50)
  supplierId   String?  @map("supplier_id")
  currency     String   @default("MXN") @db.VarChar(3)
  imageUrl     String?  @map("image_url")
  supplierUrl  String?  @map("supplier_url")
  notes        String?  @db.Text
  shippingEnabled Boolean  @default(false) @map("shipping_enabled")
  shippingCost    Decimal? @map("shipping_cost") @db.Decimal(10, 2)
  isShopListed    Boolean  @default(false) @map("is_shop_listed")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  reservations ProductReservation[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, isShopListed, isActive])
  @@index([supplierId])
  @@map("products")
}

// ─── PRODUCT IMAGES ───────────────────────────────

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ─── PRODUCT RESERVATIONS ─────────────────────────

model ProductReservation {
  id                     String            @id @default(uuid())
  tenantId               String            @map("tenant_id")
  productId              String            @map("product_id")
  appointmentId          String?           @map("appointment_id")
  quantity               Int               @default(1)
  unitPrice              Decimal           @map("unit_price") @db.Decimal(10, 2)
  shippingCost           Decimal           @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  customerName           String            @map("customer_name")
  customerEmail          String?           @map("customer_email")
  customerPhone          String            @map("customer_phone")
  fulfillmentType        FulfillmentType   @map("fulfillment_type")
  preferredPaymentMethod ShopPaymentMethod @map("preferred_payment_method")
  status                 ReservationStatus @default(PENDING)
  shippingAddress        String?           @map("shipping_address") @db.Text
  notes                  String?           @db.Text
  userId                 String?           @map("user_id")
  // Comprobante de pago subido por el cliente (típicamente captura de
  // pantalla de la transferencia SPEI). Lo verifica el admin para
  // confirmar el apartado.
  paymentProofUrl        String?           @map("payment_proof_url")
  // Número corto y único de la compra (ej. "RX12AB"). Lo usamos como
  // referencia humana en mensajes de WhatsApp y comunicaciones.
  code                   String?           @unique
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([productId])
  @@index([appointmentId])
  @@index([userId])
  @@map("product_reservations")
}

// ─── PROMOTIONS ─────────────────────────────────────

model Promotion {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  description String? @db.Text
  type       String   // PERCENTAGE, FIXED_AMOUNT, TWO_FOR_ONE
  value      Decimal  @db.Decimal(10, 2)
  code       String?  @db.VarChar(50)
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  maxUses    Int?     @map("max_uses")
  usedCount  Int      @default(0) @map("used_count")
  serviceIds Json?    @map("service_ids") // array of service IDs this applies to
  minAmount         Decimal? @map("min_amount") @db.Decimal(10, 2)
  allowPointPayment Boolean  @default(true) @map("allow_point_payment")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrals PromotionReferral[]

  @@index([tenantId, isActive])
  @@index([code])
  @@map("promotions")
}

model PromotionReferral {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  promotionId           String    @map("promotion_id")
  appointmentId         String    @map("appointment_id")
  serviceIds            Json      @map("service_ids")
  code                  String    @unique @db.VarChar(12)
  generatedByClientId   String    @map("generated_by_client_id")
  redeemedByClientId    String?   @map("redeemed_by_client_id")
  redeemedAppointmentId String?   @map("redeemed_appointment_id")
  status                String    @default("ACTIVE") // ACTIVE, USED, EXPIRED
  expiresAt             DateTime? @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  usedAt                DateTime? @map("used_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@index([tenantId])
  @@index([code])
  @@map("promotion_referrals")
}

// ─── SERVICE BUNDLES ────────────────────────────────

model ServiceBundle {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  description    String?  @db.Text
  bundlePrice    Decimal  @map("bundle_price") @db.Decimal(10, 2)
  serviceIds     Json     @map("service_ids") // ordered array of service IDs
  totalDuration  Int      @map("total_duration") // sum of durations
  savingsPercent Decimal? @map("savings_percent") @db.Decimal(5, 2)
  flexibleOrder  Boolean  @default(false) @map("flexible_order")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  pointsReward         Int?     @map("points_reward")
  redeemableWithPoints Boolean  @default(false) @map("redeemable_with_points")
  pointsRequired       Int?     @map("points_required")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId, isActive])
  @@map("service_bundles")
}

// ─── STAFF NOTIFICATIONS (in-app + push) ───────────

model StaffNotification {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  userId     String    @map("user_id")
  type       String    @db.VarChar(64)
  section    String    @db.VarChar(32)
  title      String    @db.VarChar(200)
  body       String    @db.Text
  link       String?   @db.VarChar(500)
  entityType String?   @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id")
  metadata   Json?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, section, readAt])
  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("staff_notifications")
}

model PushSubscription {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  endpoint   String    @unique @db.VarChar(500)
  p256dh     String    @db.VarChar(255)
  auth       String    @db.VarChar(255)
  userAgent  String?   @map("user_agent") @db.VarChar(300)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

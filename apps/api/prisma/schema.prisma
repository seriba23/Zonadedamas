// ─── APPOINTMENTS ───────────────────────────────────

model Appointment {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  locationId         String            @map("location_id")
  clientId           String            @map("client_id")
  employeeId         String            @map("employee_id")
  status             AppointmentStatus @default(PENDING)
  startTime          DateTime          @map("start_time")
  endTime            DateTime          @map("end_time")
  notes              String?           @db.Text
  internalNotes      String?           @map("internal_notes") @db.Text
  cancellationReason String?           @map("cancellation_reason") @db.Text
  cancelledBy        String?           @map("cancelled_by")
  source             AppointmentSource @default(MANUAL)
  createdBy          String?           @map("created_by")
  photoConsent       Boolean?          @map("photo_consent")
  photoConsentAt     DateTime?         @map("photo_consent_at")
  // El empleado finalizó el servicio (consent + fotos) pero delegó el cobro
  // al POS de recepción. La cita queda IN_PROGRESS y aparece en /pos con
  // badge "Por cobrar" hasta que el cajero registre el pago.
  pendingPosPayment  Boolean           @default(false) @map("pending_pos_payment")
  // Token de "Confirmación del cliente" — se le entrega al cliente via QR
  // o link al cerrar la cita; al abrir el link confirma el cobro y deja
  // su reseña. Idempotente: el empleado puede regenerar el mismo si lo pide.
  confirmationToken  String?           @unique @map("confirmation_token")
  confirmedAt        DateTime?         @map("confirmed_at")
  bundleId           String?           @map("bundle_id")
  redemptionId       String?           @unique @map("redemption_id")
  discountAmount     Decimal?          @map("discount_amount") @db.Decimal(10, 2)
  pointsSpent        Int               @default(0) @map("points_spent")
  // Captura del comprobante de pago subido por el cliente (típicamente
  // transferencia SPEI). El admin lo verifica para registrar el pago.
  paymentProofUrl    String?           @map("payment_proof_url")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      Location                   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  client        Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employee      Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bundle        ServiceBundle?             @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  redemption    RewardRedemption?          @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  items         AppointmentItem[]
  statusHistory AppointmentStatusHistory[]
  payments      Payment[]
  review        EmployeeReview?
  photos              AppointmentPhoto[]
  productReservations ProductReservation[]

  @@index([tenantId, locationId, startTime])
  @@index([employeeId, startTime, endTime])
  @@index([clientId])
  @@index([status])
  @@index([pendingPosPayment])
  @@map("appointments")
}

model AppointmentItem {
  id                  String   @id @default(uuid())
  appointmentId       String   @map("appointment_id")
  serviceId           String   @map("service_id")
  employeeId          String   @map("employee_id")
  resourceId          String?  @map("resource_id")
  startTime           DateTime @map("start_time")
  endTime             DateTime @map("end_time")
  priceSnapshot       Decimal  @map("price_snapshot") @db.Decimal(10, 2)
  commissionSnapshot  Decimal? @map("commission_snapshot") @db.Decimal(10, 2)
  durationSnapshot    Int      @map("duration_snapshot")
  serviceNameSnapshot String   @map("service_name_snapshot")
  notes               String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  resource    Resource?   @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([employeeId, startTime, endTime])
  @@map("appointment_items")
}

model AppointmentStatusHistory {
  id            String             @id @default(uuid())
  appointmentId String             @map("appointment_id")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  STRIPE
  OTHER
}

enum AppointmentSource {
  ONLINE
  WALK_IN
  PHONE
  MANUAL
}

enum NotificationType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum PaymentItemType {
  SERVICE
  PRODUCT
  OTHER
}

enum NotificationStatus {
  SENT
  FAILED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SubscriptionPlan {
  BASICO
  PLUS
  PRO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  VOID
}

enum BusinessType {
  SALON
  BARBERIA
  SPA
  CLINICA
  TATUAJES
}

enum FulfillmentType {
  PICKUP
  SHIPPING
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  READY
  DELIVERED
  CANCELLED
}

enum ShopPaymentMethod {
  CASH
  SPEI
  CARD
}

enum TenantType {
  FREELANCER
  BUSINESS
}

// ─── PLATFORM USERS (Super Admin) ──────────────────

model PlatformUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens PlatformRefreshToken[]

  @@map("platform_users")
}

model PlatformRefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  tokenHint String    @default("") @map("token_hint")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHint])
  @@index([userId])
  @@map("platform_refresh_tokens")
}

// ─── MARKETPLACE USERS (Global Client Identity) ────

// ─── TENANTS ────────────────────────────────────────

model Tenant {
  id                   String    @id @default(uuid())
  name                 String
  slug                 String    @unique
  email                String
  phone                String?
  logoUrl              String?   @map("logo_url")
  timezone             String    @default("UTC")
  currency             String    @default("MXN")
  settings             Json?
  businessType         String?   @map("business_type")
  address              String?
  businessPhone        String?   @map("business_phone")
  posWhatsappNumber    String?   @map("pos_whatsapp_number")
  description          String?   @db.Text
  coverImageUrl        String?   @map("cover_image_url")
  cardColor            String?   @map("card_color")
  isMarketplaceListed      Boolean   @default(false) @map("is_marketplace_listed")
  contractAcceptedAt       DateTime? @map("contract_accepted_at")
  stripeAccountId          String?   @map("stripe_account_id")
  stripeOnboardingComplete Boolean   @default(false) @map("stripe_onboarding_complete")
  subscriptionPlan     String    @default("free") @map("subscription_plan")
  subscriptionStatus   String    @default("active") @map("subscription_status")
  tenantType           TenantType @default(BUSINESS) @map("tenant_type")
  shopEnabled          Boolean   @default(false) @map("shop_enabled")
  shopPickupEnabled    Boolean   @default(true) @map("shop_pickup_enabled")
  shopShippingEnabled  Boolean   @default(false) @map("shop_shipping_enabled")
  shopPaymentCash      Boolean   @default(true) @map("shop_payment_cash")
  shopPaymentSpei      Boolean   @default(false) @map("shop_payment_spei")
  shopPaymentCard      Boolean   @default(false) @map("shop_payment_card")
  shopSpeiBankName     String?   @map("shop_spei_bank_name")
  shopSpeiHolderName   String?   @map("shop_spei_holder_name")
  shopSpeiClabe        String?   @map("shop_spei_clabe") @db.VarChar(18)
  confettiEnabled      Boolean   @default(true) @map("confetti_enabled")
  confettiStyle        String?   @map("confetti_style") @db.VarChar(40)
  confettiStyles       Json?     @map("confetti_styles")
  confettiColors       Json?     @map("confetti_colors")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  locations             Location[]
  users                 User[]
  clients               Client[]
  services              Service[]
  employees             Employee[]
  resources             Resource[]
  appointments          Appointment[]
  payments              Payment[]
  roles                 Role[]
  auditLogs             AuditLog[]
  domainEvents          DomainEvent[]
  userRoles             UserRole[]
  automationRules       AutomationRule[]
  notificationTemplates NotificationTemplate[]
  notificationLogs      NotificationLog[]
  clientTags            ClientTag[]
  businessHours         BusinessHours[]
  businessClosures      BusinessClosure[]
  employeeReviews       EmployeeReview[]
  inviteCodes           TenantInviteCode[]
  subscription          Subscription?
  invoices              Invoice[]
  appointmentPhotos     AppointmentPhoto[]
  galleryImages         TenantGalleryImage[]
  rewards               Reward[]
  rewardRedemptions     RewardRedemption[]
  rewardReferrals       RewardReferral[]
  marketplaceFavorites  MarketplaceFavorite[]
  products              Product[]
  suppliers             Supplier[]
  promotions            Promotion[]
  promotionReferrals    PromotionReferral[]
  serviceBundles        ServiceBundle[]
  productReservations   ProductReservation[]
  attendances           Attendance[]
  tenantReviews         TenantReview[]
  staffNotifications    StaffNotification[]

  @@map("tenants")
}

// ─── SUBSCRIPTIONS ─────────────────────────────────

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique @map("tenant_id")
  plan                 SubscriptionPlan   @default(BASICO)
  status               SubscriptionStatus @default(ACTIVE)
  monthlyAmountUsd     Decimal            @map("monthly_amount_usd") @db.Decimal(10, 2)
  baseMonthlyUsd       Decimal            @default(10) @map("base_monthly_usd") @db.Decimal(10, 2)
  perEmployeeUsd       Decimal            @default(10) @map("per_employee_usd") @db.Decimal(10, 2)
  billedEmployeeCount  Int                @default(0) @map("billed_employee_count")
  availableLicenses    Int                @default(0) @map("available_licenses")
  planInterval         String             @default("MONTHLY") @map("plan_interval")
  annualAmountUsd      Decimal?           @map("annual_amount_usd") @db.Decimal(10, 2)
  annualPeriodEnd      DateTime?          @map("annual_period_end")
  advancePaid          Boolean            @default(false) @map("advance_paid")
  contractStartDate    DateTime           @map("contract_start_date")
  contractEndDate      DateTime           @map("contract_end_date")
  nextBillingDate      DateTime           @map("next_billing_date")
  lastPaymentDate      DateTime?          @map("last_payment_date")
  gracePeriodEndsAt    DateTime?          @map("grace_period_ends_at")
  cancelledAt          DateTime?          @map("cancelled_at")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  stripeCustomerId     String?            @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?            @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId        String?            @map("stripe_price_id") @db.VarChar(255)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(uuid())
  subscriptionId  String        @map("subscription_id")
  tenantId        String        @map("tenant_id")
  invoiceNumber   String        @unique @map("invoice_number")
  amountUsd       Decimal       @map("amount_usd") @db.Decimal(10, 2)
  baseAmount      Decimal?      @map("base_amount") @db.Decimal(10, 2)
  employeeAmount  Decimal?      @map("employee_amount") @db.Decimal(10, 2)
  employeeCount   Int?          @map("employee_count")
  status          InvoiceStatus @default(PENDING)
  periodStart     DateTime      @map("period_start")
  periodEnd       DateTime      @map("period_end")
  dueDate         DateTime      @map("due_date")
  paidAt          DateTime?     @map("paid_at")
  notes           String?       @db.Text
  stripeInvoiceId String?       @map("stripe_invoice_id") @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

// ─── LOCATIONS ──────────────────────────────────────

model Location {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  address   String?
  phone     String?
  email     String?
  timezone  String?
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true) @map("is_active")
  settings  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees    Employee[]
  resources    Resource[]
  appointments Appointment[]
  userRoles    UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("locations")
}

// ─── USERS ──────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  tenantId        String?   @map("tenant_id")
  email           String    @unique
  phone           String?   @unique
  passwordHash    String?   @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  // ─── Cliente / marketplace profile ──────────────────────
  isClient          Boolean   @default(false) @map("is_client")
  socialProvider    String?   @map("social_provider") @db.VarChar(20)
  socialId          String?   @map("social_id") @db.VarChar(255)
  birthDate         DateTime? @map("birth_date") @db.Date
  gender            String?   @db.VarChar(20)
  allergies         String?   @db.Text
  address           String?   @db.Text
  country           String?   @db.VarChar(2)
  language          String    @default("es") @db.VarChar(5)
  currency          String    @default("LOCAL") @db.VarChar(10)
  searchRadius      Int       @default(25) @map("search_radius")
  notifAppointments Boolean   @default(true) @map("notif_appointments")
  notifPromotions   Boolean   @default(true) @map("notif_promotions")
  notifRewards      Boolean   @default(true) @map("notif_rewards")
  notifMessages     Boolean   @default(true) @map("notif_messages")
  suspendedAt       DateTime? @map("suspended_at")
  suspendedUntil    DateTime? @map("suspended_until")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant                Tenant?                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee              Employee?
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  userRoles             UserRole[]
  auditLogs             AuditLog[]
  uploadedPhotos        AppointmentPhoto[]
  clients               Client[]
  favorites             MarketplaceFavorite[]
  professionalFavorites MarketplaceProfessionalFavorite[]
  productReservations   ProductReservation[]
  tenantReviews         TenantReview[]
  staffNotifications    StaffNotification[]
  pushSubscriptions     PushSubscription[]

  @@index([tenantId])
  @@index([isClient])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  tokenHint String    @default("") @map("token_hint")
  scope     String    @default("business") @db.VarChar(20) // business | client
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHint])
  @@index([userId])
  @@index([scope])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  tokenHash  String?   @map("token_hash")
  method     String    @default("EMAIL") @db.VarChar(20)
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  usedAt     DateTime? @map("used_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── RBAC ───────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  slug        String
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  tenantId   String   @map("tenant_id")
  locationId String?  @map("location_id")
  assignedBy String?  @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([userId, tenantId])
  @@index([tenantId])
  @@map("user_roles")
}

// ─── CLIENTS ────────────────────────────────────────

model Client {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String?
  phone              String?
  gender             String?
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  notes              String?   @db.Text
  avatarUrl          String?   @map("avatar_url")
  isActive           Boolean   @default(true) @map("is_active")
  source             String?
  passwordHash       String?   @map("password_hash")
  portalRegisteredAt DateTime? @map("portal_registered_at")
  lastLoginAt        DateTime? @map("last_login_at")
  userId             String?   @map("user_id")
  loyaltyPoints      Int       @default(0) @map("loyalty_points")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments      Appointment[]
  payments          Payment[]
  tags              ClientTagMap[]
  reviews           EmployeeReview[]
  refreshTokens     ClientRefreshToken[]
  rewardRedemptions RewardRedemption[]

  // Un marketplace user solo puede tener UN Client por tenant. Esto bloquea
  // a nivel DB el caso de race condition donde dos requests del booking
  // pasan el findFirst y ambos crean (era el bug original al investigar
  // los 3 "Alfredo Ibarra"). MySQL permite multiples NULLs en un unique,
  // asi que walk-in clients sin userId siguen funcionando.
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([userId])
  @@map("clients")
}

model ClientTag {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clients ClientTagMap[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("client_tags")
}

model ClientTagMap {
  clientId  String   @map("client_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  client Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    ClientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@map("client_tag_map")
}

// ─── CLIENT REFRESH TOKENS ─────────────────────────

model ClientRefreshToken {
  id        String    @id @default(uuid())
  clientId  String    @map("client_id")
  tokenHash String    @map("token_hash")
  tokenHint String    @default("") @map("token_hint")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tokenHint])
  @@index([clientId])
  @@map("client_refresh_tokens")
}

// ─── SERVICES ───────────────────────────────────────

model Service {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  name                String
  description         String?  @db.Text
  durationMinutes     Int      @map("duration_minutes")
  bufferBeforeMinutes Int      @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int      @default(0) @map("buffer_after_minutes")
  price               Decimal  @db.Decimal(10, 2)
  currency            String   @default("MXN")
  color               String   @default("#6366f1")
  category            String?
  subcategory         String?
  pointsReward        Int?     @map("points_reward")
  redeemableWithPoints Boolean @default(false) @map("redeemable_with_points")
  pointsRequired      Int?     @map("points_required")
  depositRequired     Boolean  @default(false) @map("deposit_required")
  depositPercent      Int?     @map("deposit_percent")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeServices EmployeeService[]
  addons           ServiceAddon[]
  appointmentItems AppointmentItem[]
  serviceResources ServiceResource[]
  rewards          Reward[]
  inviteCodes      TenantInviteCodeService[]
  portfolioImages  EmployeePortfolioImage[]
  appointmentPhotos AppointmentPhoto[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("services")
}

model ServiceAddon {
  id              String   @id @default(uuid())
  serviceId       String   @map("service_id")
  name            String
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_addons")
}

// ─── EMPLOYEES ──────────────────────────────────────

model Employee {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  userId              String?  @unique @map("user_id")
  locationId          String   @map("location_id")
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  email               String?
  phone               String?
  avatarUrl           String?  @map("avatar_url")
  coverImageUrl       String?  @map("cover_image_url")
  color               String   @default("#008080")
  bio                 String?  @db.Text
  bloodType                String?  @map("blood_type") @db.VarChar(5)
  emergencyContactName     String?  @map("emergency_contact_name")
  emergencyContactLastName String?  @map("emergency_contact_last_name")
  emergencyContactPhone    String?  @map("emergency_contact_phone")
  emergencyContactRelation String?  @map("emergency_contact_relation") @db.VarChar(50)
  allergies                String?  @db.Text
  jobTitle            String?  @map("job_title")
  managerId           String?  @map("manager_id")
  isActive            Boolean  @default(true) @map("is_active")
  bufferBeforeMinutes Int      @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int      @default(0) @map("buffer_after_minutes")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  location         Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  manager          Employee?          @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports    Employee[]         @relation("EmployeeHierarchy")
  employeeServices EmployeeService[]
  schedules        EmployeeSchedule[]
  timeOffs         EmployeeTimeOff[]
  appointments     Appointment[]
  appointmentItems AppointmentItem[]
  portfolioImages  EmployeePortfolioImage[]
  reviews          EmployeeReview[]
  documents        EmployeeDocument[]
  trainings              EmployeeTraining[]
  professionalFavorites  MarketplaceProfessionalFavorite[]
  attendances            Attendance[]

  @@index([tenantId])
  @@index([tenantId, locationId])
  @@map("employees")
}

model Attendance {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  employeeId      String           @map("employee_id")
  date            DateTime         @db.Date
  checkInTime     DateTime?        @map("check_in_time")
  checkInLat      Float?           @map("check_in_lat")
  checkInLng      Float?           @map("check_in_lng")
  checkInDistance Float?           @map("check_in_distance")
  checkOutTime    DateTime?        @map("check_out_time")
  checkOutLat     Float?           @map("check_out_lat")
  checkOutLng     Float?           @map("check_out_lng")
  checkOutDistance Float?          @map("check_out_distance")
  status          AttendanceStatus @default(APPROVED)
  reviewedBy      String?          @map("reviewed_by")
  reviewedAt      DateTime?        @map("reviewed_at")
  notes           String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
